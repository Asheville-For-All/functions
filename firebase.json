{
  "functions": [
    {
      "source": "./",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "venv",
        ".git",
        ".env",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "admin_code.py",
        "gemini_code_misc_scratch.py"
      ],
      "runtime": "python314"
    }
  ],
  "firestore": {
    "database": "default",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
