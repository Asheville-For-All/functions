rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /people/{person} {
      allow write: if true;
      allow read: if false;
    }
    match /events/{evnt}{
      allow write: if false;
      allow read: if true;
    }
    match /people/{person}/rsvps/{rsvp} {
      allow write: if true;
      allow read: if false;
    }
  }
}